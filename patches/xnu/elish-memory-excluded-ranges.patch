+/*
+ * The excluded range with the lowest end above pa. Its base may lie above pa.
+ */
+bool
+arm_vm_excluded_range(pmap_paddr_t pa, pmap_paddr_t *base, pmap_paddr_t *end)
+{
+	for (unsigned int i = 0; i < arm_vm_excluded_count; i++) {
+		if (pa < arm_vm_excluded_table[i].end) {
+			*base = arm_vm_excluded_table[i].base;
+			*end = arm_vm_excluded_table[i].end;
+			return true;
+		}
+	}
+	return false;
+}
+
+/*
+ * Excluded bytes inside [start, end).
+ */
+uint64_t
+arm_vm_excluded_bytes(pmap_paddr_t start, pmap_paddr_t end)
+{
+	uint64_t bytes = 0;
+
+	for (unsigned int i = 0; i < arm_vm_excluded_count; i++) {
+		const pmap_paddr_t from = MAX(start, arm_vm_excluded_table[i].base);
+		const pmap_paddr_t to = MIN(end, arm_vm_excluded_table[i].end);
+
+		if (from < to) {
+			bytes += to - from;
+		}
+	}
+	return bytes;
+}
+
+/*
+ * Read the loader's excluded ranges into a table at avail_start. Runs on the bootstrap translation tables,
+ * before the first boot allocation.
+ */
+static void
+arm_vm_excluded_init(boot_args *args)
+{
+	const pmap_paddr_t span_end = gPhysBase + mem_size;
+	const pmap_paddr_t table_pa = (avail_start + PAGE_MASK) & ~((pmap_paddr_t)PAGE_MASK);
+	const pmap_paddr_t reserve_end = args->topOfKernelData + ARM_VM_EXCLUDED_RESERVE(mem_size);
+	arm_vm_excluded_range_t *table;
+	DTEntry chosen;
+	const uint8_t *pairs;
+	unsigned int pairs_size;
+	unsigned int count = 0;
+
+	if (span_end < gPhysBase) {
+		panic("overflow in XNU managed memory span");
+	}
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "darwinboot-memory-excluded", (void const **)&pairs, &pairs_size) != kSuccess) {
+		return;
+	}
+	if (pairs_size < 2 * sizeof(uint64_t) ||
+	    (pairs_size % (2 * sizeof(uint64_t))) != 0 ||
+	    (pairs_size / (2 * sizeof(uint64_t))) > 256) {
+		panic("invalid darwinboot-memory-excluded property size %u", pairs_size);
+	}
+	if (reserve_end < args->topOfKernelData) {
+		panic("overflow in excluded-memory boot allocation reserve");
+	}
+
+	/* Validate the early boot allocation area before using it for the table. */
+	for (unsigned int offset = 0; offset < pairs_size; offset += 2 * sizeof(uint64_t)) {
+		uint64_t base, size, end;
+		memcpy(&base, pairs + offset, sizeof(base));
+		memcpy(&size, pairs + offset + sizeof(base), sizeof(size));
+		if (size == 0) {
+			continue;
+		}
+		end = base + size;
+		if (end < base) {
+			panic("overflow in darwinboot-memory-excluded range at 0x%llx",
+			    (unsigned long long)base);
+		}
+		if (end <= gPhysBase || base >= span_end) {
+			continue;
+		}
+		base = MAX(base & ~((uint64_t)PAGE_MASK), (uint64_t)gPhysBase);
+		end = MIN(end, (uint64_t)span_end);
+		if (end > (~(uint64_t)0) - PAGE_MASK) {
+			panic("overflow while aligning excluded memory range at 0x%llx",
+			    (unsigned long long)base);
+		}
+		end = (end + PAGE_MASK) & ~((uint64_t)PAGE_MASK);
+		if (base < reserve_end && end > args->topOfKernelData) {
+			panic("excluded memory at 0x%llx overlaps the kernel's early allocations",
+			    (unsigned long long)base);
+		}
+	}
+	table = (arm_vm_excluded_range_t *)phystokv(table_pa);
+
+	for (unsigned int offset = 0; offset + 2 * sizeof(uint64_t) <= pairs_size; offset += 2 * sizeof(uint64_t)) {
+		uint64_t base, size, end;
+		unsigned int at;
+
+		/* A device tree property is aligned to four bytes only. */
+		memcpy(&base, pairs + offset, sizeof(base));
+		memcpy(&size, pairs + offset + sizeof(base), sizeof(size));
+		if (size == 0) {
+			continue;
+		}
+		/* The kernel's page may be larger than the loader's: a partly excluded page is excluded. */
+		end = base + size;
+		if (end <= gPhysBase || base >= span_end) {
+			continue;
+		}
+		base = MAX(base & ~((uint64_t)PAGE_MASK), (uint64_t)gPhysBase);
+		end = MIN(end, (uint64_t)span_end);
+		if (end > (~(uint64_t)0) - PAGE_MASK) {
+			panic("overflow while aligning excluded memory range at 0x%llx",
+			    (unsigned long long)base);
+		}
+		end = (end + PAGE_MASK) & ~((uint64_t)PAGE_MASK);
+		if (base >= end) {
+			continue;
+		}
+		if (base < reserve_end && end > args->topOfKernelData) {
+			panic("excluded memory at 0x%llx overlaps the kernel's early allocations",
+			    (unsigned long long)base);
+		}
+		/* Insert in ascending order, then join with the neighbours it touches. */
+		for (at = count; at > 0 && table[at - 1].base > base; at--) {
+			table[at] = table[at - 1];
+		}
+		table[at].base = base;
+		table[at].end = end;
+		count++;
+		if (at > 0 && table[at - 1].end >= table[at].base) {
+			at--;
+		}
+		while (at + 1 < count && table[at].end >= table[at + 1].base) {
+			table[at].end = MAX(table[at].end, table[at + 1].end);
+			for (unsigned int i = at + 1; i + 1 < count; i++) {
+				table[i] = table[i + 1];
+			}
+			count--;
+		}
+	}
+	if (count == 0) {
+		return;
+	}
+
+	arm_vm_excluded_table_pa = table_pa;
+	arm_vm_excluded_table = table;
+	arm_vm_excluded_count = count;
+	avail_start = (table_pa + count * sizeof(*table) + PAGE_MASK) & ~((pmap_paddr_t)PAGE_MASK);
+	arm_vm_excluded_size = arm_vm_excluded_bytes(gPhysBase, span_end);
+}
