diff --git a/scripts/unixnu/test_bootimg.py b/scripts/unixnu/test_bootimg.py
new file mode 100644
index 0000000..8b4a0c5
--- /dev/null
+++ b/scripts/unixnu/test_bootimg.py
@@ -0,0 +1,101 @@
+#!/usr/bin/env python3
+"""Exercise boot-image kernel compression and optional appended device trees."""
+import gzip
+import json
+from pathlib import Path
+import struct
+import sys
+from tempfile import TemporaryDirectory
+from types import SimpleNamespace
+import unittest
+import zlib
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from unixnu import bootimg
+
+PAGE = 4096
+DTB = struct.pack('>II', 0xd00dfeed, 8)
+FAKE_MKBOOTIMG = r'''#!/usr/bin/env python3
+import argparse
+from pathlib import Path
+import struct
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--kernel', required=True)
+parser.add_argument('--ramdisk', required=True)
+parser.add_argument('-o', required=True)
+parser.add_argument('--base', type=lambda value: int(value, 0), default=0)
+parser.add_argument('--kernel_offset', type=lambda value: int(value, 0), default=0x8000)
+parser.add_argument('--tags_offset', type=lambda value: int(value, 0), default=0x1e00000)
+parser.add_argument('--pagesize', type=int, default=4096)
+parser.add_argument('--header_version', type=int, default=0)
+parser.add_argument('--ramdisk_offset', type=lambda value: int(value, 0), default=0x1000000)
+args = parser.parse_args()
+
+page = args.pagesize
+kernel = Path(args.kernel).read_bytes()
+ramdisk = Path(args.ramdisk).read_bytes()
+header = bytearray(page)
+header[:8] = b'ANDROID!'
+struct.pack_into('<10I', header, 8, len(kernel), args.base + args.kernel_offset,
+                 len(ramdisk), args.base + args.ramdisk_offset if ramdisk else 0,
+                 0, 0, args.base + args.tags_offset, page, args.header_version, 0)
+kernel_padding = bytes((-len(kernel)) % page)
+Path(args.o).write_bytes(bytes(header) + kernel + kernel_padding + ramdisk)
+'''
+
+
+class BootImageKernel(unittest.TestCase):
+    def test_device_kernel_options_control_build_and_round_trip(self):
+        for compression in ('gzip', 'none'):
+            for append_dtb in (True, False):
+                with self.subTest(compression=compression, append_dtb=append_dtb), TemporaryDirectory() as temp:
+                    root = Path(temp)
+                    uefi = root / 'uefi'
+                    (uefi / 'Resources/Configs').mkdir(parents=True)
+                    (uefi / 'Resources/Scripts').mkdir(parents=True)
+                    config = uefi / 'Resources/Configs/elish.toml'
+                    config.write_text(
+                        '[boot_shim]\nrequires_kernel_header = true\n'
+                        '[uefi_fd]\nbase = 0x9fc00000\nsize = 7\n'
+                        f'[boot_image_kernel]\nkernel_compression = "{compression}"\nappend_dtb = {str(append_dtb).lower()}\n'
+                        '[boot_image]\nheader_version = 0\nbase = 0\nkernel_offset = 0x8000\n'
+                        'tags_offset = 0x1e00000\npagesize = 4096\n'
+                    )
+                    (uefi / 'Resources/Scripts/mkbootimg.py').write_text(FAKE_MKBOOTIMG)
+                    fd = root / 'uefi.fd'
+                    fd.write_bytes(b'UEFI-FD')
+                    dtb = root / 'device.dtb'
+                    dtb.write_bytes(DTB)
+                    output = root / 'out/boot.img'
+                    ctx = SimpleNamespace(
+                        board={'firmware': {'config': 'elish'}},
+                        work=root / 'work',
+                        logs=root / 'logs',
+                        tree=root,
+                    )
+
+                    with patch.object(bootimg, 'compile_shim', return_value=b'SHIM'):
+                        bootimg.build(ctx, uefi, fd, dtb, output=output)
+
+                    report = json.loads((output.parent / 'boot.json').read_text())
+                    image = output.read_bytes()
+                    kernel_size = struct.unpack_from('<I', image, 8)[0]
+                    kernel = image[PAGE:PAGE + kernel_size]
+                    combined = b'SHIM' + fd.read_bytes()
+                    expected_tail = DTB if append_dtb else b''
+
+                    self.assertEqual(report['kernel_compression'], compression)
+                    self.assertEqual(report['dtb_appended'], append_dtb)
+                    if compression == 'gzip':
+                        unpacker = zlib.decompressobj(16 + zlib.MAX_WBITS)
+                        self.assertEqual(unpacker.decompress(kernel), combined)
+                        self.assertTrue(unpacker.eof)
+                        self.assertEqual(unpacker.unused_data, expected_tail)
+                    else:
+                        self.assertEqual(kernel, combined + expected_tail)
+
+
+if __name__ == '__main__':
+    unittest.main()
