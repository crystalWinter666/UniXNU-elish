diff --git a/DarwinBootPkg/Driver/PayloadDisk.h b/DarwinBootPkg/Driver/PayloadDisk.h
new file mode 100644
--- /dev/null
+++ b/DarwinBootPkg/Driver/PayloadDisk.h
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Verify the full FDT initrd even when the boot volume is an unaligned FAT
+// suffix published as a relative-offset child of that raw block device.
+STATIC
+BOOLEAN
+DarwinVerifyPayloadDisk (EFI_HANDLE Volume, UINT64 Start, UINT64 Bytes)
+{
+  EFI_BLOCK_IO_PROTOCOL                   *Disk;
+  EFI_BLOCK_IO_PROTOCOL                   *Child;
+  EFI_DEVICE_PATH_PROTOCOL                *Path;
+  EFI_DEVICE_PATH_PROTOCOL                *ParentPath;
+  EFI_DEVICE_PATH_PROTOCOL                *Node;
+  EFI_DEVICE_PATH_PROTOCOL                *Remaining;
+  MEDIA_RELATIVE_OFFSET_RANGE_DEVICE_PATH *Range;
+  EFI_HANDLE                              Parent;
+  UINT64                                  Size;
+  UINT64                                  Offset;
+  UINT64                                  ChildBytes;
+  UINT8                                   Sector[512];
+  EFI_STATUS                              Status;
+
+  if ((Bytes < sizeof (Sector)) || (Bytes > MAX_UINT64 - 511)) { return FALSE; }
+  Size = ALIGN_VALUE (Bytes, 512);
+  if (Size > MAX_UINT64 - Start) { return FALSE; }
+  if (EFI_ERROR (gBS->HandleProtocol (Volume, &gEfiBlockIoProtocolGuid, (VOID **)&Disk)) ||
+      (Disk->Media == NULL)) { return FALSE; }
+
+  if (Disk->Media->LogicalPartition) {
+    Child = Disk;
+    if (!Child->Media->MediaPresent || Child->Media->BlockSize != sizeof (Sector) ||
+        Child->Media->LastBlock >= MAX_UINT64 / sizeof (Sector) ||
+        EFI_ERROR (gBS->HandleProtocol (Volume, &gEfiDevicePathProtocolGuid, (VOID **)&Path))) { return FALSE; }
+    ParentPath = DuplicateDevicePath (Path);
+    if (ParentPath == NULL) { return FALSE; }
+    Node = ParentPath;
+    while (!IsDevicePathEnd (Node) && !IsDevicePathEnd (NextDevicePathNode (Node))) {
+      Node = NextDevicePathNode (Node);
+    }
+    if ((DevicePathType (Node) != MEDIA_DEVICE_PATH) ||
+        (DevicePathSubType (Node) != MEDIA_RELATIVE_OFFSET_RANGE_DP) ||
+        (DevicePathNodeLength (Node) != sizeof (*Range))) {
+      FreePool (ParentPath);
+      return FALSE;
+    }
+    Range = (MEDIA_RELATIVE_OFFSET_RANGE_DEVICE_PATH *)Node;
+    Offset = ReadUnaligned64 (&Range->StartingOffset);
+    ChildBytes = (Child->Media->LastBlock + 1) * sizeof (Sector);
+    if ((Range->Reserved != 0) || (Offset >= Bytes) || (ChildBytes > Bytes - Offset) ||
+        (ReadUnaligned64 (&Range->EndingOffset) != Offset + ChildBytes - 1)) {
+      FreePool (ParentPath);
+      return FALSE;
+    }
+    SetDevicePathEndNode (Node);
+    Remaining = ParentPath;
+    Status = gBS->LocateDevicePath (&gEfiBlockIoProtocolGuid, &Remaining, &Parent);
+    if (EFI_ERROR (Status) || !IsDevicePathEnd (Remaining) || Parent == Volume) {
+      FreePool (ParentPath);
+      return FALSE;
+    }
+    Status = gBS->HandleProtocol (Parent, &gEfiBlockIoProtocolGuid, (VOID **)&Disk);
+    FreePool (ParentPath);
+    if (EFI_ERROR (Status)) { return FALSE; }
+
+    if (EFI_ERROR (Child->ReadBlocks (Child, Child->Media->MediaId, 0, sizeof (Sector), Sector)) ||
+        (CompareMem (Sector, (CONST VOID *)(UINTN)(Start + Offset), sizeof (Sector)) != 0) ||
+        EFI_ERROR (Child->ReadBlocks (Child, Child->Media->MediaId, Child->Media->LastBlock, sizeof (Sector), Sector)) ||
+        (CompareMem (Sector, (CONST VOID *)(UINTN)(Start + Offset + ChildBytes - sizeof (Sector)), sizeof (Sector)) != 0)) {
+      return FALSE;
+    }
+  }
+
+  return (Disk->Media != NULL) && !Disk->Media->LogicalPartition && Disk->Media->MediaPresent &&
+         (Disk->Media->BlockSize == sizeof (Sector)) && (Disk->Media->LastBlock == Size / sizeof (Sector) - 1) &&
+         !EFI_ERROR (Disk->ReadBlocks (Disk, Disk->Media->MediaId, 0, sizeof (Sector), Sector)) &&
+         (CompareMem (Sector, (CONST VOID *)(UINTN)Start, sizeof (Sector)) == 0) &&
+         !EFI_ERROR (Disk->ReadBlocks (Disk, Disk->Media->MediaId, Disk->Media->LastBlock, sizeof (Sector), Sector)) &&
+         (CompareMem (Sector, (CONST VOID *)(UINTN)(Start + Size - sizeof (Sector)), sizeof (Sector)) == 0);
+}
diff --git a/Test/test-payload-disk.py b/Test/test-payload-disk.py
new file mode 100644
--- /dev/null
+++ b/Test/test-payload-disk.py
@@ -0,0 +1,107 @@
+#!/usr/bin/env python3
+"""Verify raw/relative-offset initrd disks and reject unrelated or corrupt volumes."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+driver = Path(__file__).resolve().parents[1] / 'DarwinBootPkg/Driver'
+with tempfile.TemporaryDirectory(prefix='darwinboot-payload-disk-') as temporary:
+    work = Path(temporary)
+    (work / 'test.c').write_text(r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+typedef uint8_t UINT8; typedef uint16_t UINT16; typedef uint32_t UINT32; typedef uint64_t UINT64;
+typedef size_t UINTN; typedef int BOOLEAN; typedef void VOID; typedef void *EFI_HANDLE; typedef int EFI_STATUS;
+#define STATIC static
+#define CONST const
+#define TRUE 1
+#define FALSE 0
+#define MAX_UINT64 UINT64_MAX
+#define ALIGN_VALUE(n,a) (((n)+(a)-1)&~((UINT64)(a)-1))
+#define EFI_ERROR(n) ((n)!=0)
+#define CompareMem memcmp
+#define FreePool free
+#define MEDIA_DEVICE_PATH 4
+#define MEDIA_RELATIVE_OFFSET_RANGE_DP 8
+#pragma pack(push,1)
+typedef struct { UINT8 Type, SubType; UINT16 Length; } EFI_DEVICE_PATH_PROTOCOL;
+typedef struct { EFI_DEVICE_PATH_PROTOCOL Header; UINT32 Reserved; UINT64 StartingOffset, EndingOffset; } MEDIA_RELATIVE_OFFSET_RANGE_DEVICE_PATH;
+typedef struct { EFI_DEVICE_PATH_PROTOCOL Vendor; UINT8 Guid[16]; MEDIA_RELATIVE_OFFSET_RANGE_DEVICE_PATH Range; EFI_DEVICE_PATH_PROTOCOL End; } CHILD_PATH;
+#pragma pack(pop)
+typedef struct { UINT32 MediaId; BOOLEAN LogicalPartition, MediaPresent; UINT32 BlockSize; UINT64 LastBlock; } MEDIA;
+typedef struct BLOCK BLOCK;
+struct BLOCK { MEDIA *Media; EFI_STATUS (*ReadBlocks)(BLOCK *,UINT32,UINT64,UINTN,VOID *); };
+typedef BLOCK EFI_BLOCK_IO_PROTOCOL;
+static int gEfiBlockIoProtocolGuid, gEfiDevicePathProtocolGuid;
+static UINT8 Memory[8192];
+static UINT64 Offset=187;
+static MEDIA RawMedia={1,0,1,512,15}, ChildMedia={1,1,1,512,7};
+static BLOCK Raw, Child;
+static CHILD_PATH Path;
+static int BadRead, Corrupt, MissingParent;
+#define RAW ((EFI_HANDLE)(uintptr_t)1)
+#define CHILD ((EFI_HANDLE)(uintptr_t)2)
+static UINT64 ReadUnaligned64(const VOID *p) { UINT64 v; memcpy(&v,p,8); return v; }
+static BOOLEAN IsDevicePathEnd(const EFI_DEVICE_PATH_PROTOCOL *p) { return p->Type==0x7f; }
+static EFI_DEVICE_PATH_PROTOCOL *NextDevicePathNode(EFI_DEVICE_PATH_PROTOCOL *p) { return (VOID *)((UINT8 *)p+p->Length); }
+static int DevicePathType(const EFI_DEVICE_PATH_PROTOCOL *p) { return p->Type; }
+static int DevicePathSubType(const EFI_DEVICE_PATH_PROTOCOL *p) { return p->SubType; }
+static int DevicePathNodeLength(const EFI_DEVICE_PATH_PROTOCOL *p) { return p->Length; }
+static VOID SetDevicePathEndNode(EFI_DEVICE_PATH_PROTOCOL *p) { *p=(EFI_DEVICE_PATH_PROTOCOL){0x7f,0xff,4}; }
+static EFI_DEVICE_PATH_PROTOCOL *DuplicateDevicePath(EFI_DEVICE_PATH_PROTOCOL *p) {
+  CHILD_PATH *copy=malloc(sizeof(*copy)); memcpy(copy,p,sizeof(*copy)); return (VOID *)copy;
+}
+static EFI_STATUS Read(BLOCK *b,UINT32 id,UINT64 lba,UINTN bytes,VOID *dest) {
+  if(BadRead || id!=b->Media->MediaId || bytes!=512 || lba>b->Media->LastBlock) return 1;
+  memcpy(dest,Memory+(b==&Child?Offset:0)+lba*512,bytes);
+  if(Corrupt==(b==&Child?2:1)) ((UINT8 *)dest)[0]^=1;
+  return 0;
+}
+static EFI_STATUS Handle(EFI_HANDLE h,VOID *guid,VOID **out) {
+  if(guid==&gEfiBlockIoProtocolGuid && (h==RAW || h==CHILD)) { *out=h==RAW?(VOID *)&Raw:(VOID *)&Child; return 0; }
+  if(guid==&gEfiDevicePathProtocolGuid && h==CHILD) { *out=&Path; return 0; }
+  return 1;
+}
+static EFI_STATUS Locate(VOID *guid,EFI_DEVICE_PATH_PROTOCOL **p,EFI_HANDLE *h) {
+  if(MissingParent || guid!=&gEfiBlockIoProtocolGuid || memcmp(*p,&Path,20)) return 1;
+  *p=NextDevicePathNode(*p); if(!IsDevicePathEnd(*p)) return 1;
+  *h=RAW; return 0;
+}
+static struct { EFI_STATUS (*HandleProtocol)(EFI_HANDLE,VOID *,VOID **); EFI_STATUS (*LocateDevicePath)(VOID *,EFI_DEVICE_PATH_PROTOCOL **,EFI_HANDLE *); } Services={Handle,Locate}, *gBS=&Services;
+#include "PayloadDisk.h"
+int main(void) {
+  for(size_t i=0;i<sizeof(Memory);i++) Memory[i]=(UINT8)(i*7+i/512);
+  Raw=(BLOCK){&RawMedia,Read}; Child=(BLOCK){&ChildMedia,Read};
+  Path.Vendor=(EFI_DEVICE_PATH_PROTOCOL){1,4,20};
+  Path.Range.Header=(EFI_DEVICE_PATH_PROTOCOL){4,8,24};
+  Path.Range.StartingOffset=Offset; Path.Range.EndingOffset=Offset+4096-1;
+  SetDevicePathEndNode(&Path.End);
+  UINT64 start=(UINT64)(uintptr_t)Memory;
+  assert(DarwinVerifyPayloadDisk(RAW,start,sizeof(Memory)));
+  assert(DarwinVerifyPayloadDisk(CHILD,start,sizeof(Memory)));
+  assert(DarwinVerifyPayloadDisk(CHILD,start,sizeof(Memory)-3)); // rounded raw disk, exact child bounds
+  assert(!DarwinVerifyPayloadDisk(CHILD,start,UINT64_MAX));
+  assert(!DarwinVerifyPayloadDisk(CHILD,UINT64_MAX-100,8192));
+  assert(!DarwinVerifyPayloadDisk(CHILD,start,1));
+  for(int n=1;n<=2;n++) { Corrupt=n; assert(!DarwinVerifyPayloadDisk(CHILD,start,8192)); } Corrupt=0;
+  BadRead=1; assert(!DarwinVerifyPayloadDisk(CHILD,start,8192)); BadRead=0;
+  MissingParent=1; assert(!DarwinVerifyPayloadDisk(CHILD,start,8192)); MissingParent=0;
+  RawMedia.LastBlock--; assert(!DarwinVerifyPayloadDisk(CHILD,start,8192)); RawMedia.LastBlock++;
+  RawMedia.LogicalPartition=1; assert(!DarwinVerifyPayloadDisk(CHILD,start,8192)); RawMedia.LogicalPartition=0;
+  RawMedia.MediaPresent=0; assert(!DarwinVerifyPayloadDisk(CHILD,start,8192)); RawMedia.MediaPresent=1;
+  ChildMedia.LastBlock=UINT64_MAX; assert(!DarwinVerifyPayloadDisk(CHILD,start,8192)); ChildMedia.LastBlock=7;
+  ChildMedia.BlockSize=4096; assert(!DarwinVerifyPayloadDisk(CHILD,start,8192)); ChildMedia.BlockSize=512;
+  Path.Range.StartingOffset=8192; assert(!DarwinVerifyPayloadDisk(CHILD,start,8192)); Path.Range.StartingOffset=Offset;
+  Path.Range.EndingOffset++; assert(!DarwinVerifyPayloadDisk(CHILD,start,8192)); Path.Range.EndingOffset--;
+  Path.Range.Reserved=1; assert(!DarwinVerifyPayloadDisk(CHILD,start,8192)); Path.Range.Reserved=0;
+  Path.Range.Header.SubType=1; assert(!DarwinVerifyPayloadDisk(CHILD,start,8192)); Path.Range.Header.SubType=8;
+  return 0;
+}
+''')
+    binary = work / 'test'
+    subprocess.run(['clang', '-Wall', '-Wextra', '-Werror', '-fsanitize=address,undefined',
+                    '-fno-sanitize-recover=all', '-I', str(driver), str(work / 'test.c'), '-o', str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)
+print('Payload disk: raw/child identity, unaligned bounds, corrupt reads and missing parents passed')
