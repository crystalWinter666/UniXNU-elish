// SPDX-License-Identifier: BSD-2-Clause-Patent
// Xiaomi Pad 5 Pro Wi-Fi (elish, SM8250-AC / Snapdragon 870).
//
// DRAM ranges are measured from the live elish FDT. DarwinBoot resolves the
// available pages from the runtime UEFI map and passes exclusions to XNU.
/dts-v1/;

/include/ "sm8250.dtsi"

/ {
    #address-cells = <2>;
    #size-cells = <2>;
    model = "Xiaomi Pad 5 Pro Wi-Fi";
    compatible = "xiaomi,elish", "qcom,sm8250";

    memory@80000000 {
        device_type = "memory";
        reg = <0x00000000 0x80000000 0x00000000 0x3bb00000
              0x00000000 0xc0000000 0x00000001 0xc0000000>;
    };

    chosen {
        unixnu,board = "elish";
    };
};
