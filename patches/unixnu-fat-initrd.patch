diff --git a/package/UniXNUPkg/Driver/UniXNURamDiskDxe/FatSuffix.h b/package/UniXNUPkg/Driver/UniXNURamDiskDxe/FatSuffix.h
new file mode 100644
--- /dev/null
+++ b/package/UniXNUPkg/Driver/UniXNURamDiskDxe/FatSuffix.h
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Android v3 bootloaders may prepend a vendor gzip archive to a raw FAT32
+// ramdisk without aligning the concatenation. Only accept a complete FAT32
+// volume that consumes the remaining initrd, with consistent BPB geometry.
+STATIC
+BOOLEAN
+FindFatSuffix (
+  IN CONST UINT8  *Source,
+  IN UINTN        Bytes,
+  OUT UINTN       *Offset,
+  OUT UINT64      *VolumeBytes
+  )
+{
+  UINTN        Position;
+  CONST UINT8  *Boot;
+  UINT32       Sectors;
+  UINT32       FatSectors;
+  UINT32       Reserved;
+  UINT32       ClusterSectors;
+  UINT32       Clusters;
+  UINT32       Root;
+  UINT64       DataStart;
+
+  if ((Bytes < 512) || (Source[0] != 0x1F) || (Source[1] != 0x8B) || (Source[2] != 8)) {
+    return FALSE;
+  }
+
+  for (Position = 1; Position <= Bytes - 512; Position++) {
+    Boot = Source + Position;
+    if (!((Boot[0] == 0xEB && Boot[2] == 0x90) || Boot[0] == 0xE9) ||
+        (Boot[510] != 0x55) || (Boot[511] != 0xAA) ||
+        (ReadUnaligned16 ((CONST UINT16 *)(Boot + 11)) != 512) ||
+        (ReadUnaligned16 ((CONST UINT16 *)(Boot + 17)) != 0) ||
+        (ReadUnaligned16 ((CONST UINT16 *)(Boot + 19)) != 0) ||
+        (ReadUnaligned16 ((CONST UINT16 *)(Boot + 22)) != 0) ||
+        (ReadUnaligned16 ((CONST UINT16 *)(Boot + 42)) != 0) ||
+        ((Boot[16] != 1) && (Boot[16] != 2))) {
+      continue;
+    }
+
+    ClusterSectors = Boot[13];
+    Reserved      = ReadUnaligned16 ((CONST UINT16 *)(Boot + 14));
+    Sectors       = ReadUnaligned32 ((CONST UINT32 *)(Boot + 32));
+    FatSectors    = ReadUnaligned32 ((CONST UINT32 *)(Boot + 36));
+    Root          = ReadUnaligned32 ((CONST UINT32 *)(Boot + 44));
+    DataStart     = Reserved + (UINT64)Boot[16] * FatSectors;
+    if ((ClusterSectors == 0) || (ClusterSectors > 128) ||
+        ((ClusterSectors & (ClusterSectors - 1)) != 0) ||
+        (Reserved == 0) || (FatSectors == 0) || (DataStart >= Sectors) ||
+        ((UINT64)Sectors * 512 != Bytes - Position)) {
+      continue;
+    }
+
+    Clusters = (UINT32)((Sectors - DataStart) / ClusterSectors);
+    if ((Clusters < 65525) || (Clusters > 0x0FFFFFEE) ||
+        ((UINT64)FatSectors * 128 < (UINT64)Clusters + 2) || (Root < 2) || (Root >= Clusters + 2)) {
+      continue;
+    }
+
+    *Offset      = Position;
+    *VolumeBytes = (UINT64)Sectors * 512;
+    return TRUE;
+  }
+
+  return FALSE;
+}
diff --git a/scripts/test-initrd-fat-suffix.py b/scripts/test-initrd-fat-suffix.py
new file mode 100644
--- /dev/null
+++ b/scripts/test-initrd-fat-suffix.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+"""Check real FAT32 suffix discovery, unaligned prefixes and malformed geometry."""
+import ctypes
+from pathlib import Path
+import struct
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+driver = root / 'package/UniXNUPkg/Driver/UniXNURamDiskDxe'
+with tempfile.TemporaryDirectory(prefix='unixnu-fat-suffix-') as temporary:
+    work = Path(temporary)
+    (work / 'test.c').write_text('''
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+typedef uint8_t UINT8; typedef uint16_t UINT16; typedef uint32_t UINT32; typedef uint64_t UINT64;
+typedef size_t UINTN; typedef int BOOLEAN;
+#define STATIC static
+#define CONST const
+#define IN
+#define OUT
+#define TRUE 1
+#define FALSE 0
+static UINT16 ReadUnaligned16(const UINT16 *p) { UINT16 v; memcpy(&v,p,2); return v; }
+static UINT32 ReadUnaligned32(const UINT32 *p) { UINT32 v; memcpy(&v,p,4); return v; }
+#include "FatSuffix.h"
+int find(const UINT8 *p, size_t n, size_t *offset, UINT64 *bytes) { return FindFatSuffix(p,n,offset,bytes); }
+''')
+    library = work / 'test.so'
+    subprocess.run(['clang', '-Wall', '-Wextra', '-Werror', '-O2', '-shared', '-fPIC',
+                    '-I', str(driver),
+                    str(work / 'test.c'), '-o', str(library)], check=True)
+    lib = ctypes.CDLL(str(library))
+    lib.find.argtypes = [ctypes.c_char_p, ctypes.c_size_t, ctypes.POINTER(ctypes.c_size_t), ctypes.POINTER(ctypes.c_uint64)]
+    def find(blob):
+        offset, size = ctypes.c_size_t(), ctypes.c_uint64()
+        found = lib.find(blob, len(blob), ctypes.byref(offset), ctypes.byref(size))
+        return (offset.value, size.value) if found else None
+    image = work / 'fat.img'
+    with image.open('wb') as stream:
+        stream.truncate(64 << 20)
+    subprocess.run(['mkfs.fat', '-F', '32', str(image)], check=True, capture_output=True)
+    fat = image.read_bytes()
+    for count in [3, 187, 512, 4097]:
+        prefix = b'\x1f\x8b\x08' + bytes(count - 3)
+        assert find(prefix + fat) == (count, len(fat))
+    assert find(fat) is None  # direct FAT keeps the original block device
+    assert find(b'\x1f\x8b\x08') is None
+    assert find(b'\x1f\x8b\x08' + fat[:-1]) is None
+    assert find(b'\x1f\x8b\x08' + fat + b'x') is None
+    for offset, size, value in [(11, 2, 4096), (13, 1, 3), (14, 2, 0), (16, 1, 3),
+                                (17, 2, 1), (19, 2, 1), (22, 2, 1), (32, 4, 0xFFFFFFFF),
+                                (36, 4, 1), (42, 2, 1), (44, 4, 1), (510, 2, 0)]:
+        broken = bytearray(fat)
+        struct.pack_into({1: '<B', 2: '<H', 4: '<I'}[size], broken, offset, value)
+        # Also remove the backup BPB so malformed main headers cannot match it.
+        backup = struct.unpack_from('<H', fat, 50)[0] * 512
+        broken[backup:backup + 512] = bytes(512)
+        assert find(b'\x1f\x8b\x08' + broken) is None, offset
+print('FAT suffix: real FAT32, unaligned prefixes, truncation and invalid BPBs passed')
