diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1335,6 +1335,108 @@
 
 static int initproc_spawned = 0;
 
+static unsigned elish_liveactivities_exits;
+static unsigned elish_liveactivities_status;
+static unsigned elish_liveactivities_breakpoint_state;
+static struct {
+	uint64_t pc, lr;
+	unsigned pid, slide, comment;
+} elish_liveactivities_breakpoint;
+
+void
+elish_record_user_breakpoint(uint64_t pc, uint64_t lr, unsigned slide, unsigned comment)
+{
+	proc_t p = current_proc();
+	if (p == PROC_NULL || strcmp(proc_best_name(p), "liveactivitiesd") != 0 ||
+	    !os_atomic_cmpxchg(&elish_liveactivities_breakpoint_state, 0, 1, relaxed)) {
+		return;
+	}
+	elish_liveactivities_breakpoint.pc = pc;
+	elish_liveactivities_breakpoint.lr = lr;
+	elish_liveactivities_breakpoint.pid = proc_getpid(p);
+	elish_liveactivities_breakpoint.slide = slide;
+	elish_liveactivities_breakpoint.comment = comment;
+	os_atomic_store(&elish_liveactivities_breakpoint_state, 2, release);
+}
+
+void
+elish_format_user_breakpoint(char *out, size_t size)
+{
+	if (os_atomic_load(&elish_liveactivities_breakpoint_state, acquire) == 2) {
+		snprintf(out, size, "BRK %x pid %u slide %x\nPC %llx LR %llx",
+		    elish_liveactivities_breakpoint.comment, elish_liveactivities_breakpoint.pid,
+		    elish_liveactivities_breakpoint.slide, (unsigned long long)elish_liveactivities_breakpoint.pc, (unsigned long long)elish_liveactivities_breakpoint.lr);
+	}
+}
+
+struct elish_userspace_sample {
+	int pids[8];
+	char *springboard_stack;
+	char *chronod_stack;
+	size_t stack_size;
+};
+
+extern void elish_snapshot_user_threads(task_t, char *, size_t, unsigned, unsigned);
+extern int elish_format_workqueue(proc_t, char *, size_t);
+
+static int
+elish_snapshot_process(proc_t p, void *context)
+{
+	struct elish_userspace_sample *sample = context;
+	const char *name = proc_best_name(p);
+	int slot;
+	if (proc_getpid(p) == 1 && strcmp(name, "launchd") == 0) {
+		slot = 0;
+	} else if (strcmp(name, "backboardd") == 0) {
+		slot = 1;
+	} else if (strcmp(name, "SpringBoard") == 0) {
+		slot = 2;
+	} else if (strcmp(name, "Setup") == 0) {
+		slot = 3;
+	} else if (strcmp(name, "liveactivitiesd") == 0) {
+		slot = 4;
+	} else if (strcmp(name, "chronod") == 0) {
+		slot = 6;
+	} else if (strcmp(name, "pkd") == 0) {
+		slot = 7;
+	} else if (strcmp(name, "lsd") == 0) {
+		kauth_cred_t cred = kauth_cred_proc_ref(p);
+		if (!IS_VALID_CRED(cred)) {
+			return PROC_RETURNED;
+		}
+		const uid_t uid = kauth_cred_getuid(cred);
+		kauth_cred_unref(&cred);
+		if (uid != 501) {
+			return PROC_RETURNED;
+		}
+		slot = 5;
+	} else {
+		return PROC_RETURNED;
+	}
+	sample->pids[slot] = proc_getpid(p);
+	if (slot == 2) {
+		elish_snapshot_user_threads(proc_task(p), sample->springboard_stack, sample->stack_size, 14, 1);
+	} else if (slot == 6) {
+		char *stack = sample->chronod_stack;
+		const size_t size = sample->stack_size;
+		const int used = elish_format_workqueue(p, stack, size);
+		if (used >= 0 && (size_t)used < size) {
+			elish_snapshot_user_threads(proc_task(p), stack + used, size - used, 22, 1);
+		}
+	}
+	return PROC_RETURNED;
+}
+
+void
+elish_snapshot_processes(int pids[10], char *springboard, char *chronod, size_t stack_size)
+{
+	struct elish_userspace_sample sample = { .springboard_stack = springboard, .chronod_stack = chronod, .stack_size = stack_size };
+	proc_iterate(PROC_ALLPROCLIST | PROC_NOWAITTRANS, elish_snapshot_process, &sample, NULL, NULL);
+	memcpy(pids, sample.pids, sizeof(sample.pids));
+	pids[8] = os_atomic_load(&elish_liveactivities_exits, acquire);
+	pids[9] = os_atomic_load(&elish_liveactivities_status, relaxed);
+}
