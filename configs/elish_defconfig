# elish 内核配置 —— 阶段 1：进入内核（source 4K XNU 到 panic 屏）
#
# 进入条件：无。这是所有后续阶段的基础，QEMU 参考同样先跑通这一级。
# 期望验收（官方 bring-up 阶段 1–3，docs/zh/porting/bring-up.md）：
#   - `unixnu bootimg` 出来的 boot.img 能被 stock ABL `fastboot boot` 起来（不复位、仍在 bootloader）；
#   - framebuffer 有输出或串口有 UEFI 输出；UniXNU 菜单出现，日志以 `UNIXNU:` 开头；
#   - DarwinBoot 打印虚拟/物理基址、参数地址、入口地址后退出 boot services；
#   - 内核入口探针在屏幕上出现（无 UART，panic 屏是唯一内核输出通道）；此时还没有 root 卷。
#
# 本文件与 enuma（同 SM8250-AC 平板家族）阶段 1 defconfig 一致，仅换板名注释。
# 真机基线对照 = reAAAq/UniXNU-umi（小米 10 / SM8250，已跑到 Hello/Setup/持久 Data）。
#
# 明确留到后续阶段的开关：
#   NATIVE_UFS          SM8250 是 UFS 3.1，需 GCC/PHY/ICE 常量                      → 阶段 2
#   NATIVE_MOBILE_DISPLAY / NATIVE_LEGACY_DISPLAY    SM8250 DPU                     → 阶段 3
#   触摸                开关名待核对                                                  → 阶段 3
#   OWNER_* / VERIFIED_ROOT_PROBE / BOOT_PROGRESS    需要 owner 签名的卷策略         → 阶段 4
#   NATIVE_ADRENO       A740 套件；elish 是 Adreno 650                              → 阶段 5（GPU）
# SHENG_PMGR 链接 original-PMGR 桥（scripts/build-platform-power.py，不访问硬件）；缺了它原版
# AMFI 会以 "No PMGR" panic。

CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_SHENG_PMGR=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# 被裁掉组件的探针需要 no-op 钩子（scripts/build-link-stubs.py，通用）。
CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/link-stubs/libLinkStubs.a"
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n

# 归档构建器必须显式打开：kernel.py 的 build_archives() 在没有 XNU_BUILD_ARCHIVES 时直接 return，
# 于是 [kernel] archives 里的构建器根本不会跑 —— 表现为内核链接期缺 _sheng_pmgr_run 等 no-op 探针符号。
CONFIG_XNU_BUILD_ARCHIVES=y
