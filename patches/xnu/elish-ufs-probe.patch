+static size_t
+elish_format_thread(thread_t thread, char *out, size_t out_size, unsigned frame_limit)
+{
+	uintptr_t frames[24];
+	struct backtrace_user_info info = BTUINFO_INIT;
+	unsigned count = 0;
+	const kern_return_t status = thread_suspend(thread);
+	if (status == KERN_SUCCESS) {
+		const struct backtrace_control ctl = { .btc_user_thread = thread };
+		count = backtrace_user(frames, MIN(frame_limit, sizeof(frames) / sizeof(frames[0])), &ctl, &info);
+		thread_resume(thread);
+	}
+	int used = snprintf(out, out_size, "\nT%llu K%u E%u", thread_tid(thread), status, info.btui_error);
+	for (unsigned i = 0; i < count && used >= 0 && (size_t)used < out_size; i++) {
+		const int n = snprintf(out + used, out_size - (size_t)used, "%s%lx",
+		    i % 3 == 0 ? "\n" : " ", (unsigned long)frames[i]);
+		if (n < 0) break;
+		used += n;
+	}
+	return used < 0 ? 0 : (size_t)used;
+}
+
+/* Terminal sample of threads outside the workqueue's parked wait. */
+void
+elish_snapshot_user_threads(task_t task, char *out, size_t out_size, unsigned frame_limit, unsigned thread_limit)
+{
+	thread_t selected[3];
+	thread_t thread;
+	unsigned count = 0;
+	unsigned active = 0;
+
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		spl_t s = splsched();
+		thread_lock(thread);
+		const bool parked = (thread->state & TH_WAIT) && thread->block_hint == kThreadWaitParkedWorkQueue;
+		thread_unlock(thread);
+		splx(s);
+		if (!parked) {
+			active++;
+			if (count < MIN(thread_limit, sizeof(selected) / sizeof(selected[0]))) {
+				thread_reference(thread);
+				selected[count++] = thread;
+			}
+		}
+	}
+	const uint32_t slide = task->task_shared_region_slide;
+	task_unlock(task);
+	int header = snprintf(out, out_size, "Slide %x active %u", slide, active);
+	size_t used = header < 0 ? out_size : (size_t)header;
+	for (unsigned i = 0; i < count; i++) {
+		if (used < out_size) {
+			used += elish_format_thread(selected[i], out + used, out_size - used, frame_limit);
+		}
+		thread_deallocate(selected[i]);
+	}
+}
