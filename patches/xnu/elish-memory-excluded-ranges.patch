+/*
+ * Excluded ranges: parts of [gPhysBase, gPhysBase + mem_size) that are not memory the kernel may use, such as
+ * a gap between two DRAM banks or memory the firmware keeps. The loader lists them in the device tree property
+ * /chosen/darwinboot-memory-excluded as (base, size) pairs of 64-bit values; a pair of size zero is an unused
+ * slot. The table below is a sorted copy with page-aligned, non-overlapping entries inside the managed span. It
+ * lives in boot-allocated memory because IOKit frees the flattened device tree.
+ *
+ * A page of an excluded range has its entry in the linear page array and in the pmap's per-page tables, but it
+ * never reaches the free list, is not stolen by the boot allocator, has no physical aperture mapping, and does
+ * not count as memory.
+ *
+ * Everything the kernel places directly behind the loaded image before the VM takes over (translation tables,
+ * the pmap's tables) is contiguous. The loader keeps ARM_VM_EXCLUDED_RESERVE bytes behind the image free of
+ * excluded ranges; those allocations take about 1/320 of the span plus a few megabytes.
+ */
+#define ARM_VM_EXCLUDED_RESERVE(span) MAX((span) / 64, (uint64_t)32 * 1024 * 1024)
+
+typedef struct {
+	pmap_paddr_t base;
+	pmap_paddr_t end;
+} arm_vm_excluded_range_t;
+
+SECURITY_READ_ONLY_LATE(static pmap_paddr_t)              arm_vm_excluded_table_pa;
+SECURITY_READ_ONLY_LATE(static arm_vm_excluded_range_t *) arm_vm_excluded_table;
