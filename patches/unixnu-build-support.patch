+def memory_span(entry, allow_disjoint=False):
+    """Return the enclosing physical span of a memory node's non-overlapping ranges."""
+    ranges = registers(entry)
+    if not ranges:
+        raise Error('ADT handoff requires at least one DRAM range')
+    if len(ranges) > 1 and not allow_disjoint:
+        raise Error('ADT handoff requires one contiguous DRAM range unless excluded ranges are enabled')
+    ordered = sorted(ranges)
+    previous_end = None
+    for base, size in ordered:
+        end = base + size
+        if size <= 0 or end <= base:
+            raise Error(f'{entry.name}: invalid DRAM range {base:#x}+{size:#x}')
+        if previous_end is not None and base < previous_end:
+            raise Error(f'{entry.name}: overlapping DRAM ranges')
+        previous_end = end
+    return ordered[0][0], previous_end - ordered[0][0]
+
