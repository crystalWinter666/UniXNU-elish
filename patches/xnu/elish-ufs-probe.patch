 #pragma mark misc
 
+int
+elish_format_workqueue(proc_t p, char *out, size_t size)
+{
+	struct workqueue *wq = proc_get_wqptr(p);
+	if (wq == NULL) {
+		return snprintf(out, size, "WQ absent\n");
+	}
+	if (!workq_lock_try(wq)) {
+		return snprintf(out, size, "WQ busy\n");
+	}
+	const unsigned threads = wq->wq_nthreads;
+	const unsigned idle = wq->wq_thidlecount;
+	const unsigned pending = wq->wq_reqcount;
+	const unsigned fulfilled = wq->wq_fulfilled;
+	const unsigned flags = _wq_flags(wq);
+	const unsigned creator = wq->wq_creator != NULL;
+	workq_unlock(wq);
+	return snprintf(out, size, "WQ total %u idle %u req %u done %u F%x C%u\n",
+	    threads, idle, pending, fulfilled, flags, creator);
+}
